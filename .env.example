# Copy to .env and fill in ONE of the two auth options.

# Option A — API keys (simplest for running locally).
# Create them at https://dev-portal.onshape.com -> API keys (read scope is enough).
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=

# Option B — OAuth app (use this once coworkers sign in with their own Onshape accounts).
# Register at https://dev-portal.onshape.com -> OAuth applications; redirect must match exactly.
ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=
ONSHAPE_REDIRECT_URI=http://localhost:3100/auth/onshape/callback

# Server
PORT=3100
# 127.0.0.1 = this computer only. Use 0.0.0.0 to let other shop PCs connect.
HOST=127.0.0.1

# Advanced (defaults shown)
# ONSHAPE_BASE_URL=https://cad.onshape.com
# ONSHAPE_API_VERSION=v6
